# Copia este archivo a .env y rellena los valores.
#   cp .env.example .env
# El .env es personal y nunca se sube al repositorio.

# ---------------------------------------------------------------------------
# URL del entorno bajo prueba.
#
# Déjala comentada si esta carpeta está dentro del proyecto de la aplicación:
# la URL se toma automáticamente del APP_URL de Laravel (tu dominio de Herd).
#
# Descoméntala solo para apuntar a otro sitio, o si la suite está en una
# carpeta suelta:
# BASE_URL=https://mi-app.test
# ---------------------------------------------------------------------------

# Credenciales de un usuario que exista en la base de datos del entorno anterior.
# Si corres contra tu base local, tienen que ser de un usuario de TU base,
# no las de staging.
AUTH_USER=
AUTH_PASS=
