# Copia este archivo a .env y rellena los valores.
#   cp .env.example .env
# El .env es personal y nunca se sube al repositorio.

# Entorno contra el que corren las pruebas.
#   Local con Herd:  https://qa-terium.test   (ajusta al dominio .test de tu máquina)
#   Staging:         https://demo.staging.terium-labs.com
BASE_URL=https://qa-terium.test

# Credenciales de la cuenta con la que se autentican las pruebas.
AUTH_USER=
AUTH_PASS=
